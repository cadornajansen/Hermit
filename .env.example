# Copy to .env.local. Every eGov service runs on a mock until ALL of its
# variables below are set — then it switches to the real egov.js client.
# Base URLs default to the documented hackathon hosts; override per service
# with EGOV_<SERVICE>_BASE_URL (SSO, LIVENESS, EVERIFY, EMESSAGE, AI, PAY, REPORT).

# Required in production: signs the session cookie.
SESSION_SECRET=

# eGovPH Single Sign-On. LOGIN_URL takes a {callback} placeholder,
# e.g. https://<sso-host>/login?redirect_uri={callback}
EGOV_SSO_PARTNER_CODE=
EGOV_SSO_PARTNER_SECRET=
EGOV_SSO_LOGIN_URL=

# Face Liveness
EGOV_LIVENESS_API_KEY=

# National ID eVerify
EGOV_EVERIFY_CLIENT_ID=
EGOV_EVERIFY_CLIENT_SECRET=

# eMessage (SMS reminders)
EGOV_EMESSAGE_TOKEN=

# eGov AI (classification + Kuya Hermit explanations)
EGOV_AI_ACCESS_CODE=

# eGovPay (fees, P2)
EGOV_PAY_TOKEN=
EGOV_PAY_SETTLEMENT_TEMPLATE=

# eReport (red-tape reports from the office locator)
EGOV_EREPORT_ACCESS_CODE=
EGOV_EREPORT_REPORT_TYPE=

# eGovChain (vault anchoring, stretch — adapter throws until a signer is wired)
EGOV_CHAIN_TOKEN=

# Email/password accounts. Use a public publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative to the publishable key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Trusted site URL for confirmation emails. Add this callback URL to Supabase's
# redirect allow list: http://localhost:3000/auth/callback (and your deployed URL).
APP_URL=http://localhost:3000
