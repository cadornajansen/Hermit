# Copy to .env.local. Every eGov service runs on a mock until ALL of its
# variables below are set — then it switches to the real egov.js client.
# Base URLs default to the documented hackathon hosts; override per service
# with EGOV_<SERVICE>_BASE_URL (SSO, LIVENESS, EVERIFY, EMESSAGE, AI, PAY, REPORT).

# Required in production: signs the session + owner cookies.
SESSION_SECRET=

# Kuya Hermit — AssemblyAI LLM Gateway (OpenAI-compatible). Without it, a
# keyword search over the rules table answers instead.
ASSEMBLYAI_API_KEY=
# Optional; any model id from https://llm-gateway.assemblyai.com/v1/models
HERMIT_MODEL=claude-opus-5-5

# Supabase (filled in by the Vercel Marketplace integration: `vercel env pull`).
# Without these the app runs device-only (localStorage + IndexedDB).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Used only to apply supabase/migrations with psql
POSTGRES_URL_NON_POOLING=

# eGovPH Single Sign-On (credential from the eGov developer portal).
# In-app entry URL to give eGovPH: https://<your-domain>/egovph/sso
EGOV_SSO_BASE_URL=https://platforms-api.e.gov.ph/egov-sso
EGOV_SSO_PARTNER_CODE=
EGOV_SSO_PARTNER_SECRET=
# For the "Login as eGov" widget (the partner code is safe to expose)
NEXT_PUBLIC_EGOV_SSO_PARTNER_CODE=
NEXT_PUBLIC_EGOV_SSO_HOST=https://platforms-api.e.gov.ph/egov-sso

# National ID (PhilSys) eVerify + Face Liveness Web SDK public key
EGOV_EVERIFY_BASE_URL=https://platforms-api.e.gov.ph/everify
EGOV_EVERIFY_CLIENT_ID=
EGOV_EVERIFY_CLIENT_SECRET=
NEXT_PUBLIC_EGOV_LIVENESS_PUBKEY=

# eMessage (SMS reminders)
EGOV_EMESSAGE_TOKEN=

# eGov AI (classification + Kuya Hermit explanations)
EGOV_AI_ACCESS_CODE=

# eGovPay (fees, P2)
EGOV_PAY_TOKEN=
EGOV_PAY_SETTLEMENT_TEMPLATE=

# eReport (red-tape reports from the office locator)
EGOV_EREPORT_ACCESS_CODE=
EGOV_EREPORT_REPORT_TYPE=

# eGovChain (vault anchoring, stretch — adapter throws until a signer is wired)
EGOV_CHAIN_TOKEN=
